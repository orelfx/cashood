node_modules/
.DS_Store
*.log
.env
.databranch/

# Berkas data ditulis ulang tiap sepuluh menit dan tinggal di branch `data`.
# Dilacak di `main`, setiap push kode ikut membawa snapshot basi dan memicu
# build GitHub Pages — persis yang dulu menghabiskan jatah build sampai situs
# berhenti diperbarui.
data/*/live.json
data/*/trades.json
data/*/trades/
data/*/nav.json
data/*/heartbeat.json
data/*/fees.json

# Catatan transfer kas: ditulis bot pencatat di server, bisa memuat hash
# transaksi. Yang terbit adalah ringkasannya di live.json, tanpa hash.
data/*/treasury.jsonl

# Berkas rahasia Safe Box: hanya ada di server, tidak pernah terbit.
data/safebox/position.local.json
data/safebox/accrual.json
data/safebox/internal.json
data/safebox/daily.json

# Alamat dompet No Risk No Ferari: dibaca sync, tidak pernah terbit.
data/ferari/wallet.local.json
data/ferari/closed.json

dist/
*.lock.local
data/*/*.local.json
data/*/*.tmp
reports/private/
data/*/payouts.jsonl

# Riwayat posisi Robsol dari LP Agent (bisa memuat alamat posisi).
data/robsol/closed.json
